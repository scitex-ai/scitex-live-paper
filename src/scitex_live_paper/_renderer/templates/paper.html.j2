<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<meta name="generator" content="scitex-live-paper">
<link rel="stylesheet" href="{{ sdk_header_css_url }}">
<link rel="stylesheet" href="{{ css_url }}">
<link rel="stylesheet" href="{{ support_css_url }}">
<link rel="stylesheet" href="{{ paper_css_url }}">
</head>
<body class="live-paper lp-paper-page">
<a class="lp-skip-link" href="#lp-paper-main">Skip to the manuscript</a>
<div data-stx-app-header
     data-app-title="SciTeX Live Paper"
     data-app-version="{{ app_version }}">
  <p class="lp-static-header-fallback">SciTeX Live Paper{% if project_label %} · {{ project_label }}{% endif %}</p>
  {% if project_label %}<span data-lp-static-project>{{ project_label }}</span>{% endif %}
</div>

<div class="lp-paper-layout">
  {# Claims navigator: needs inspection first (the packet's order). Plain
     #claim-<id> links, so it works without JavaScript; paper.js turns each
     into "scroll to the mark, highlight it, open its evidence panel". #}
  <nav class="lp-claim-nav" id="lp-claim-nav" aria-labelledby="lp-claim-nav-title">
    <details class="lp-claim-nav-box" open>
      <summary><h2 id="lp-claim-nav-title" class="lp-claim-nav-title">Claims ({{ claims_data|length }})</h2></summary>
      <p class="lp-claim-nav-hint">Needs inspection first. Select a claim to see it in the text with its evidence graph.</p>
      {% for group_title, group in nav_groups %}{% if group %}
      <h3 class="lp-claim-nav-group">{{ group_title }} ({{ group|length }})</h3>
      <ol class="lp-claim-nav-list">
        {% for e in group %}<li><a class="lp-claim-nav-item" href="#claim-{{ e.claim_id }}" data-claim-id="{{ e.claim_id }}" data-support="{{ e.state }}" title="{{ e.label }}: {{ e.reason }}"><span class="lp-claim-nav-symbol" aria-hidden="true">{{ e.symbol }}</span><span class="lp-visually-hidden">{{ e.label }}: </span><span class="lp-claim-nav-id">{{ e.claim_id }}</span>{% if e.stated_text %} <span class="lp-claim-nav-text">{{ e.stated_text }}</span>{% endif %}</a></li>
        {% endfor %}
      </ol>
      {% endif %}{% endfor %}
    </details>
  </nav>

  <main class="lp-paper-shell" id="lp-paper-main" data-review-schema-version="{{ review.schema_version }}">
    <p class="live-paper-subtitle">Manuscript with every <strong>registered</strong> claim marked by its evidence state (supplied by the evidence provider <code>{{ review.provider.name }}</code>).
      Unmarked text is not a registered claim and is not assessed.
      Select a mark (click, tap or Enter) to open its evidence panel.
      <a href="{{ claims_url }}#needs-inspection">Needs inspection: {{ review.needs_inspection|length }}</a></p>
    <p class="lp-support-legend" aria-label="Legend">
      {% for state, label in review.states.items() %}<span class="lp-support-badge" data-support="{{ state }}">{{ review.symbols[state] }} {{ label }}: {{ review.counts[state] }}</span>{% endfor %}
    </p>
    {% for s in sections %}
    <p class="lp-paper-file"><code>{{ s.file }}</code></p>
    <article class="lp-paper-text" data-file="{{ s.file }}">
      {% for line in s.lines %}<span class="lp-paper-line">{{ line }}</span>
      {% endfor %}
    </article>
    {% endfor %}
  </main>
</div>

{# The evidence panel: non-modal, so the paper stays readable and scrollable
   beside it. paper.js fills it from #lp-claims-data with DOM text nodes
   (never HTML from the data). Esc or the close button closes it and returns
   focus to the claim. #}
<aside id="lp-claim-panel" class="lp-claim-panel" role="dialog" aria-modal="false"
       aria-labelledby="lp-claim-panel-title" hidden>
  <div class="lp-claim-panel-head">
    <h2 id="lp-claim-panel-title" class="lp-claim-panel-title" tabindex="-1">Claim</h2>
    <button type="button" class="lp-claim-panel-close" aria-label="Close evidence panel" title="Close (Esc)">×</button>
  </div>
  <div class="lp-claim-panel-body"></div>
</aside>

<footer class="live-paper-footer">
  <span>scitex-live-paper · claim states from the evidence provider · select a mark for its evidence panel (Esc closes) · mermaid v{{ mermaid_version }} (vendored)</span>
</footer>
<script id="lp-claims-data" type="application/json">{{ claims_data|tojson }}</script>
<script type="module" src="{{ sdk_header_js_url }}"></script>
<script type="module" src="{{ sdk_header_slot_js_url }}"></script>
<script src="{{ mermaid_url }}" defer></script>
<script src="{{ paper_panel_js_url }}" defer></script>
<script src="{{ paper_js_url }}" defer></script>
</body>
</html>
