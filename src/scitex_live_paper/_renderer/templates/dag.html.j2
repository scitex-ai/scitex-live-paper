<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>{{ title|default('Live Paper — DAG') }}</title>
<meta name="generator" content="scitex-live-paper">
<link rel="stylesheet" href="{{ sdk_header_css_url }}">
<link rel="stylesheet" href="{{ css_url }}">
{% if support_css_url %}<link rel="stylesheet" href="{{ support_css_url }}">{% endif %}
</head>
<body class="live-paper">
{# Canonical SDK AppHeader (header-parity rule): one header row built by
   the component; page subtitles live in <main>. #}
<div data-stx-app-header
     data-app-title="SciTeX Live Paper"
     data-app-version="{{ app_version }}">
  {# file:// fallback: module scripts (SDK component) only run over
     http(s); this line keeps a title row where they don't. Hidden the
     moment the component mounts (see CSS). #}
  <p class="lp-static-header-fallback">SciTeX Live Paper{% if project_label %} · {{ project_label }}{% endif %}</p>
  {% if project_label %}<span data-lp-static-project>{{ project_label }}</span>{% endif %}
</div>

<main class="lp-dag-shell"
      data-viewer-url="{{ viewer_url }}"
      data-claims-url="{{ claims_url }}">
  <p class="live-paper-subtitle">{{ subtitle or 'Bundle provenance graph' }} · mermaid v{{ mermaid_version }} (vendored)</p>

  {% if claim %}
  <section class="lp-claim-evidence" data-support="{{ claim.state }}" data-claim-id="{{ claim.claim_id }}" aria-label="Evidence state">
    <p class="lp-claim-evidence-state">
      <span class="lp-support-badge" data-support="{{ claim.state }}">{{ claim.symbol }} {{ claim.label }}</span>
      <span class="lp-support-reason-text">{{ claim.reason }}</span>
    </p>
    <p class="lp-claim-evidence-value">Claim <code>{{ claim.claim_id }}</code>{% if claim.stated_text %}: <q>{{ claim.stated_text }}</q>{% endif %}{% if claim.location.file %} · <code>{{ claim.location.file }}{% if claim.location.line %}:{{ claim.location.line }}{% endif %}</code>{% endif %}</p>
    <p class="lp-claim-evidence-value">Source <code>{{ claim.source.file or '(none)' }}</code>{% if claim.source.locator %} · locator <code>{{ claim.source.locator|tojson }}</code>{% else %} · no locator{% endif %}{% if claim.provider_status %} · provider verdict <code>{{ claim.provider_status.name }}{% if claim.provider_status.code is not none %} ({{ claim.provider_status.code }}){% endif %}</code>{% endif %}</p>
    {% if claim.source.value_reported %}<p class="lp-claim-evidence-value" data-value-relation="{{ value.value_check.relation if value.value_check else '' }}">Stated value <code>{{ value.stated_display if value.stated_display is not none else 'not stated' }}</code> · source value <code>{{ claim.source.value|tojson }}</code>{% if value.value_check %} <strong class="lp-value-relation">{{ value.value_check.symbol }} {{ value.value_check.text }}</strong>{% endif %}</p>{% endif %}
    {% if claim.failing_nodes %}
    <div class="lp-claim-evidence-broke" aria-label="Where the evidence broke">
      <p class="lp-claim-evidence-broke-title">Where the evidence broke ({{ claim.failing_nodes|length }} node{{ '' if claim.failing_nodes|length == 1 else 's' }}, outlined dash-dot in the graph):</p>
      <ul class="lp-failing-nodes">
        {% for f in claim.failing_nodes %}<li class="lp-failing-node" data-failure="{{ f.failure }}" data-node-id="{{ f.id }}"><span class="lp-failure-badge">⚠ {{ f.failure_label }}</span> {{ f.kind }} <code>{{ f.label }}</code>{% if f.detail %} · {{ f.detail }}{% endif %}</li>{% endfor %}
      </ul>
    </div>
    {% endif %}
    {% if claim.details %}
    <ul class="lp-claim-evidence-details">
      {% for d in claim.details %}<li>{{ d }}</li>{% endfor %}
    </ul>
    {% endif %}
    <p class="lp-claim-evidence-value"><a href="{{ claims_url }}">All claims</a>{% if paper_url %} · <a href="{{ paper_url }}#claim-{{ claim.claim_id }}">Show in paper</a>{% endif %}</p>
  </section>
  {% endif %}

  {% if has_dag %}
  <pre class="mermaid" id="lp-dag-source">{{ dag_source }}</pre>
  {% elif claim %}
  <p class="lp-dag-empty">No evidence graph for this claim{% if claim.graph_error %}: <code>{{ claim.graph_error }}</code>{% endif %}.</p>
  {% else %}
  <p class="lp-dag-empty">No <code>dag.mmd</code> in this bundle.</p>
  {% endif %}

  <aside id="lp-dag-overlay" class="lp-dag-overlay" hidden aria-live="polite">
    <button class="lp-dag-overlay-close" type="button" aria-label="Close overlay">×</button>
    <h2 class="lp-dag-overlay-title">Node</h2>
    <dl class="lp-dag-overlay-detail"></dl>
  </aside>
</main>

<footer class="live-paper-footer">
  <span>scitex-live-paper · DAG taxonomy owned upstream by the producer of <code>dag.mmd</code></span>
</footer>

<script id="lp-provenance-map" type="application/json">{{ provenance_map|tojson }}</script>
<script type="module" src="{{ sdk_header_js_url }}"></script>
<script type="module" src="{{ sdk_header_slot_js_url }}"></script>
<script src="{{ mermaid_url }}"></script>
<script type="module" src="{{ js_url }}"></script>
</body>
</html>
